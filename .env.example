# Copy to .env and fill in:  cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=eve
MYSQL_USER=eve
MYSQL_PASSWORD=evepassword

# Backend
TOKEN_SIGNATURE=change-me-to-a-long-random-string
BEARER_KEY=employee
SALT_ROUND=8
COHERE_API_KEY=your-cohere-api-key

COHERE_MODEL=command-a-03-2025
# Outgoing email for password resets, e.g. smtp://user:password@smtp.example.com:587
# (the dev compose file uses a local Mailpit inbox instead: http://localhost:8025)
SMTP_URL=
MAIL_FROM=EVE <no-reply@example.com>
# Public address of the app, used in links inside emails
APP_URL=https://localhost
# Comma-separated emails of admins (they manage departments). Takes effect on the next request.
ADMIN_EMAILS=you@example.com

# HTTPS (Caddy). The app is served at https://SITE_ADDRESS, with the API under /api.
#   localhost   -> certificate from Caddy's local CA (trust it once, see README)
#   a domain    -> Let's Encrypt certificate, fetched and renewed automatically
#                  (DNS must point at this server and ports 80/443 must be reachable)
SITE_ADDRESS=localhost
# Change if 80/443 are taken on this machine; the app is then at https://SITE_ADDRESS:HTTPS_PORT
HTTP_PORT=80
HTTPS_PORT=443

# Origins allowed to call the backend from another site (not needed behind Caddy,
# where the frontend and API share one origin)
CORS_ORIGINS=https://localhost
