# The single public entry point: HTTPS for the whole app on one origin.
#   https://<site>/       -> Next.js frontend
#   https://<site>/api/*  -> Express backend (the /api prefix is stripped)
#
# SITE_ADDRESS=localhost (the default) is served with a certificate from Caddy's own
# local CA; set it to a real domain whose DNS points here and Caddy fetches and renews
# a Let's Encrypt certificate itself. Plain HTTP is redirected to HTTPS.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:3000
	}

	# Once a real domain works over HTTPS, uncomment to make browsers refuse plain HTTP
	# for a year. Not for localhost: it would also force HTTPS on every other local port.
	# header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
